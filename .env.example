# Pick one provider — set the matching API key and the LLM_MODEL.
# Model strings follow LiteLLM's "<provider>/<model>" convention
# (OpenAI is the default and works without a prefix).

LLM_MODEL=anthropic/claude-opus-4-7

ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
# OPENAI_API_KEY=sk-YOUR_KEY_HERE
# GEMINI_API_KEY=YOUR_KEY_HERE

# Examples for LLM_MODEL:
#   anthropic/claude-opus-4-7
#   anthropic/claude-sonnet-4-6
#   gpt-4o
#   gpt-4o-mini
#   gemini/gemini-2.5-pro
#   gemini/gemini-2.5-flash
